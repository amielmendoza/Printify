# SQL Server (Prisma) — see https://pris.ly/d/connection-strings
# Example: sqlserver://HOST:1433;database=printify;user=USER;password=PASS;encrypt=true;trustServerCertificate=true
DATABASE_URL=

# Auth.js (NextAuth v5). Generate with: npx auth secret
AUTH_SECRET=

# Azure Blob Storage
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_TEMPLATES_CONTAINER=templates
AZURE_STORAGE_PHOTOS_CONTAINER=photos

# External auth/persons API (unchanged)
# (base URL is currently hardcoded in src/lib/external-api.ts)

# Image processing / background removal (unchanged from before)
PIAPI_KEY=
AZURE_VISION_KEY=
AZURE_VISION_ENDPOINT=
