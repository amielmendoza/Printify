// Printify data model — Supabase Postgres (via Prisma).
//
// The Organization/Profile/Template/Person/IdCard models below were introspected
// from the existing Supabase database (uuid PKs, timestamptz, jsonb, decimal) and
// are kept byte-for-byte so `prisma db push` only ADDS the two missing tables
// (users, print_logs) and the Auth.js profile->user link — it never alters the
// existing tables or their 17 templates / 2 orgs of data.
//
// JSON columns (placeholders, metadata, render_state) are native jsonb; Prisma
// returns/accepts them as parsed values, so db.ts mappers and the write paths use
// objects directly (no JSON.stringify/parse).
//
// No Row Level Security is relied upon: Prisma connects as the postgres role
// (bypasses RLS) and per-org isolation is enforced in app code (requireUser()).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Auth.js users: local accounts (password_hash) + external evesms users
// (external_user_id). Replaces the previous Supabase auth.users dependency.
model User {
  id                String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  email             String   @unique
  password_hash     String?
  external_user_id  String?
  external_username String?
  created_at        DateTime @default(now()) @db.Timestamptz(6)
  updated_at        DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  profile Profile?

  @@map("users")
}

model Organization {
  id         String     @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name       String
  slug       String     @unique
  logo_url   String?
  created_at DateTime   @default(now()) @db.Timestamptz(6)
  updated_at DateTime   @default(now()) @updatedAt @db.Timestamptz(6)
  idCards    IdCard[]
  persons    Person[]
  profiles   Profile[]
  templates  Template[]
  printLogs  PrintLog[]

  @@map("organizations")
}

model Profile {
  id              String        @id @db.Uuid
  organization_id String?       @db.Uuid
  full_name       String?
  role            String        @default("member")
  created_at      DateTime      @default(now()) @db.Timestamptz(6)
  updated_at      DateTime      @default(now()) @updatedAt @db.Timestamptz(6)
  organization    Organization? @relation(fields: [organization_id], references: [id], onUpdate: NoAction)
  user            User          @relation(fields: [id], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model Template {
  id              String       @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  organization_id String       @db.Uuid
  name            String
  description     String?
  file_path       String
  file_type       String
  width_inches    Decimal      @default(3.375) @db.Decimal
  height_inches   Decimal      @default(2.125) @db.Decimal
  placeholders    Json         @default("[]")
  is_active       Boolean      @default(true)
  created_at      DateTime     @default(now()) @db.Timestamptz(6)
  updated_at      DateTime     @default(now()) @updatedAt @db.Timestamptz(6)
  idCards         IdCard[]
  organization    Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([organization_id], map: "idx_templates_org")
  @@map("templates")
}

model Person {
  id              String       @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  organization_id String       @db.Uuid
  first_name      String
  last_name       String
  middle_name     String?
  photo_path      String?
  person_type     String       @default("student")
  category        String?
  id_number       String?
  email           String?
  phone           String?
  metadata        Json?        @default("{}")
  is_active       Boolean      @default(true)
  created_at      DateTime     @default(now()) @db.Timestamptz(6)
  updated_at      DateTime     @default(now()) @updatedAt @db.Timestamptz(6)
  idCards         IdCard[]
  organization    Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([last_name, first_name], map: "idx_persons_name")
  @@index([organization_id], map: "idx_persons_org")
  @@index([person_type], map: "idx_persons_type")
  @@map("persons")
}

model IdCard {
  id                String       @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  organization_id   String       @db.Uuid
  person_id         String       @db.Uuid
  template_id       String       @db.Uuid
  render_state      Json?
  exported_pdf_path String?
  status            String       @default("draft")
  valid_from        DateTime?    @db.Date
  valid_until       DateTime?    @db.Date
  created_at        DateTime     @default(now()) @db.Timestamptz(6)
  updated_at        DateTime     @default(now()) @updatedAt @db.Timestamptz(6)
  organization      Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  person            Person       @relation(fields: [person_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  template          Template     @relation(fields: [template_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([organization_id], map: "idx_id_cards_org")
  @@index([person_id], map: "idx_id_cards_person")
  @@index([template_id], map: "idx_id_cards_template")
  @@map("id_cards")
}

// Persons originate from an external API, so logs reference them by text id.
model PrintLog {
  id                 String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  organization_id    String?       @db.Uuid
  person_external_id String
  person_name        String
  template_id        String?       @db.Uuid
  template_name      String?
  action             String
  created_at         DateTime      @default(now()) @db.Timestamptz(6)
  organization       Organization? @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([organization_id])
  @@index([created_at(sort: Desc)])
  @@map("print_logs")
}
